{
  "name": "auryn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "env -u GEM_HOME -u GEM_PATH expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "assets": "node tools/generate-assets.js && node tools/slice-buttons.js && node tools/slice-tile.js && node tools/slice-crate.js && node tools/slice-pieces.js && node tools/slice-vertical.js && node tools/slice-switch.js && sh tools/sync-native-assets.sh",
    "sounds": "node tools/generate-sounds.js",
    "eas:whoami": "npx eas-cli@latest whoami",
    "eas:builds": "npx eas-cli@latest build:list --platform ios --limit 10",
    "eas:credentials": "npx eas-cli@latest credentials --platform ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production --wait",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest --wait",
    "release:ios": "pnpm verify && npx eas-cli@latest build --platform ios --profile production --auto-submit --wait"
  },
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/?(*.)test.ts?(x)"
    ]
  }
}
